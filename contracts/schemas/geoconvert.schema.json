{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeframe.dev/geoconvert/contracts/v1/geoconvert.schema.json",
  "title": "GeoConvert contract bundle",
  "$defs": {
    "SemVerMajor1": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "abbreviation", "direction", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "abbreviation": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "CoordinateReferenceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "definition",
        "realization",
        "datum_anchor_epoch",
        "frame_reference_epoch",
        "coordinate_epoch",
        "height_type",
        "axes",
        "dimensionality",
        "provenance"
      ],
      "properties": {
        "reference_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$" },
        "definition": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "authority", "code"],
              "properties": {
                "kind": { "const": "authority" },
                "authority": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
                "code": { "type": "integer", "minimum": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "enum": ["wkt2", "projjson"] },
                "value": { "oneOf": [{ "type": "string" }, { "type": "object" }] }
              }
            }
          ]
        },
        "realization": { "type": "string", "minLength": 1 },
        "datum_anchor_epoch": { "type": ["number", "null"] },
        "frame_reference_epoch": { "type": ["number", "null"] },
        "coordinate_epoch": { "type": ["number", "null"] },
        "height_type": { "enum": ["none", "ellipsoidal", "orthometric"] },
        "vertical_crs": { "type": ["string", "null"] },
        "axes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/Axis" }
        },
        "dimensionality": { "type": "integer", "minimum": 2, "maximum": 4 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "retrieved_at"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
            "licence": { "type": ["string", "null"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "height_type": { "const": "orthometric" } } },
          "then": { "required": ["vertical_crs"] }
        }
      ]
    },
    "NormalizedCoordinateReference": {
      "allOf": [
        { "$ref": "#/$defs/CoordinateReferenceDeclaration" },
        {
          "type": "object",
          "required": ["original_definition", "normalized_projjson", "definition_hash"],
          "properties": {
            "original_definition": { "type": "string", "minLength": 1 },
            "normalized_projjson": { "type": "object" },
            "definition_hash": { "$ref": "#/$defs/Sha256" }
          }
        }
      ]
    },
    "AreaOfInterest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["west", "south", "east", "north", "crosses_antimeridian", "provenance", "outside_behavior"],
      "properties": {
        "west": { "type": "number", "minimum": -180, "maximum": 180 },
        "south": { "type": "number", "minimum": -90, "maximum": 90 },
        "east": { "type": "number", "minimum": -180, "maximum": 180 },
        "north": { "type": "number", "minimum": -90, "maximum": 90 },
        "crosses_antimeridian": { "type": "boolean" },
        "minimum_height": { "type": ["number", "null"] },
        "maximum_height": { "type": ["number", "null"] },
        "provenance": { "type": "string", "minLength": 1 },
        "outside_behavior": { "enum": ["fail", "partition"] }
      }
    },
    "OperationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_accuracy_metres",
        "allow_ballpark",
        "only_best",
        "allow_superseded",
        "network_policy",
        "grid_licence_policy",
        "axis_normalization",
        "outside_area_behavior",
        "mode"
      ],
      "properties": {
        "maximum_accuracy_metres": { "type": "number", "exclusiveMinimum": 0 },
        "allow_ballpark": { "const": false },
        "only_best": { "const": true },
        "allow_superseded": { "type": "boolean" },
        "network_policy": { "const": "offline" },
        "grid_licence_policy": { "enum": ["approved-only"] },
        "axis_normalization": { "enum": ["declared-order"] },
        "outside_area_behavior": { "enum": ["fail", "partition"] },
        "mode": { "enum": ["production", "audit"] }
      }
    },
    "CoordinateTuple": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "ConversionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_crs",
        "target_crs",
        "area_of_interest",
        "operation_policy",
        "coordinates",
        "target_coordinate_epoch"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "source_crs": { "$ref": "#/$defs/CoordinateReferenceDeclaration" },
        "target_crs": { "$ref": "#/$defs/CoordinateReferenceDeclaration" },
        "area_of_interest": { "$ref": "#/$defs/AreaOfInterest" },
        "operation_policy": { "$ref": "#/$defs/OperationPolicy" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": { "$ref": "#/$defs/CoordinateTuple" }
        },
        "source_coordinate_epoch": { "type": ["number", "null"] },
        "target_coordinate_epoch": { "type": ["number", "null"] },
        "label": { "type": "string", "maxLength": 256 }
      }
    },
    "ResourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "package", "version", "sha256", "licence", "available"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "licence": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "source_side_only": { "type": "boolean" }
      }
    },
    "OperationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_crs_hash",
        "target_crs_hash",
        "source_datum_anchor_epoch",
        "source_frame_reference_epoch",
        "source_coordinate_epoch",
        "target_frame_reference_epoch",
        "target_coordinate_epoch",
        "name",
        "authority",
        "code",
        "pipeline",
        "accuracy_metres",
        "selection_area",
        "area_of_use",
        "axis_and_unit_steps",
        "resources",
        "runtime",
        "policy",
        "best_available",
        "warnings",
        "limitations",
        "numeric_execution_profile_id"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "source_crs_hash": { "$ref": "#/$defs/Sha256" },
        "target_crs_hash": { "$ref": "#/$defs/Sha256" },
        "source_datum_anchor_epoch": { "type": ["number", "null"] },
        "source_frame_reference_epoch": { "type": ["number", "null"] },
        "source_coordinate_epoch": { "type": ["number", "null"] },
        "target_frame_reference_epoch": { "type": ["number", "null"] },
        "target_coordinate_epoch": { "type": ["number", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "authority": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] },
        "pipeline": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
        "accuracy_metres": { "type": ["number", "null"] },
        "selection_area": { "$ref": "#/$defs/AreaOfInterest" },
        "area_of_use": { "type": ["object", "null"] },
        "axis_and_unit_steps": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/ResourceRecord" } },
        "runtime": { "type": "object" },
        "policy": { "$ref": "#/$defs/OperationPolicy" },
        "best_available": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "numeric_execution_profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "RowFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "code", "message"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "ConversionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "logical_request_id",
        "result_artifact_id",
        "coordinates",
        "output_axes",
        "output_realization",
        "target_frame_reference_epoch",
        "target_coordinate_epoch",
        "height_type",
        "numeric_execution_profile_id",
        "row_partitions",
        "operations",
        "failures",
        "warnings",
        "canonicalization"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "logical_request_id": { "$ref": "#/$defs/Sha256" },
        "result_artifact_id": { "$ref": "#/$defs/Sha256" },
        "coordinates": { "type": "array", "items": { "$ref": "#/$defs/CoordinateTuple" } },
        "output_axes": { "type": "array", "items": { "$ref": "#/$defs/Axis" } },
        "output_realization": { "type": "string", "minLength": 1 },
        "target_frame_reference_epoch": { "type": ["number", "null"] },
        "target_coordinate_epoch": { "type": ["number", "null"] },
        "height_type": { "enum": ["none", "ellipsoidal", "orthometric"] },
        "numeric_execution_profile_id": { "type": "string", "minLength": 1 },
        "row_partitions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/OperationRecord" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/RowFailure" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "canonicalization": { "const": "RFC8785-JCS" }
      }
    },
    "ProductionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "logical_run_id",
        "started_at",
        "finished_at",
        "request_hash",
        "result_hash",
        "source_commit",
        "release_version",
        "runtime_fingerprint",
        "platform_architecture",
        "numeric_execution_profile_id",
        "resource_inventory_hash",
        "warnings",
        "failures",
        "retry_history",
        "exit_status"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "attempt_id": { "type": "string", "format": "uuid" },
        "logical_run_id": { "$ref": "#/$defs/Sha256" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "request_hash": { "$ref": "#/$defs/Sha256" },
        "result_hash": { "$ref": "#/$defs/Sha256" },
        "source_commit": { "type": "string", "minLength": 1 },
        "release_version": { "type": "string", "minLength": 1 },
        "image_digest": { "anyOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }] },
        "runtime_fingerprint": { "type": "object" },
        "platform_architecture": { "type": "string", "minLength": 1 },
        "numeric_execution_profile_id": { "type": "string", "minLength": 1 },
        "resource_inventory_hash": { "$ref": "#/$defs/Sha256" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "type": "object" } },
        "retry_history": { "type": "array", "items": { "type": "object" } },
        "exit_status": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "CapabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_versions",
        "formats",
        "dimensions",
        "production_target",
        "numeric_execution_profile_id",
        "runtime",
        "resource_inventory_hash",
        "resources",
        "surfaces"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "contract_versions": { "type": "array", "items": { "$ref": "#/$defs/SemVerMajor1" } },
        "formats": { "type": "array", "items": { "enum": ["json", "ndjson"] } },
        "dimensions": { "type": "array", "items": { "type": "integer", "minimum": 2, "maximum": 4 } },
        "production_target": { "const": "EPSG:10605@2024.0" },
        "numeric_execution_profile_id": { "type": "string", "minLength": 1 },
        "runtime": { "type": "object" },
        "resource_inventory_hash": { "$ref": "#/$defs/Sha256" },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/ResourceRecord" } },
        "surfaces": {
          "type": "array",
          "items": { "enum": ["python", "cli", "service-deferred", "service-candidate"] }
        }
      }
    },
    "GeoConvertError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "code", "message", "details"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/SemVerMajor1" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  }
}
